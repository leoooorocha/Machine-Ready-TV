{
    "name": "Settings Gradient Background",
    "author": "Leozito",
    "version": "v1.0",
    "description": "Set a custom gradient background at settings page.",
    "target": "Settings",
    "manifest_version": 9,
    "tabs": {
        "default": [ "bigpicture" ]
    },
    "inject": {
        "shared.css": []
    },
    "patches": {
        "Background": {
            "type": "dropdown",
            "default": "Custom Gradient",
            "values": {
                "Default": {},
                "Custom": {
                    "background.css": []
                },
                "Custom Gradient": {
                    "background.css": [],
                    "--sp-bg-background": [ "linear-gradient(138deg, var(--sp-bg-background-color-a), var(--sp-bg-background-color-b))" ]
                }
            },
            "components": [
                {
                    "name": "Color",
                    "type": "color-picker",
                    "on": "Custom",
                    "default": "#bd5ece",
                    "css_variable": "--sp-bg-background",
                    "tabs": []
                },
                {
                    "name": "Color A",
                    "type": "color-picker",
                    "on": "Custom Gradient",
                    "default": "#bd5ece",
                    "css_variable": "--sp-bg-background-color-a",
                    "tabs": []
                },
                {
                    "name": "Color B",
                    "type": "color-picker",
                    "on": "Custom Gradient",
                    "default": "#2ab1ac",
                    "css_variable": "--sp-bg-background-color-b",
                    "tabs": []
                }
            ]
        },
        "Interface": {
            "type": "dropdown",
            "default": "Darker",
            "values": {
                "Default": {},
                "Darker": {
                    "interface.css": [],
                    "--sp-bg-interface-color": [ "#00000033" ]
                },
                "Brighter": {
                    "interface.css": [],
                    "--sp-bg-interface-color": [ "#ffffff20" ]
                }
            }
        },
        "Menu Highlight": {
            "type": "dropdown",
            "default": "Brighter",
            "values": {
                "Default": {},
                "Darker": {
                    "menu-highlights.css": [],
                    "--sp-bg-menu-highlight-marker": [ "#000000" ],
                    "--sp-bg-menu-highlight-color-a": [ "#00000066" ],
                    "--sp-bg-menu-highlight-color-b": [ "#00000033" ],
                    "--sp-bg-menu-highlight-color-c": [ "#00000000" ]
                },
                "Brighter": {
                    "menu-highlights.css": [],
                    "--sp-bg-menu-highlight-marker": [ "#ffffff" ],
                    "--sp-bg-menu-highlight-color-a": [ "#ffffff66" ],
                    "--sp-bg-menu-highlight-color-b": [ "#ffffff33" ],
                    "--sp-bg-menu-highlight-color-c": [ "#ffffff00" ]
                },
                "Custom": {
                    "menu-highlights.css": [],
                    "--sp-bg-menu-highlight-marker": [ "#ffffff" ],
                    "--sp-bg-menu-highlight-color-c": [ "#ffffff00" ]
                }
            },
            "components": [
                {
                    "name": "Marker",
                    "type": "color-picker",
                    "on": "Custom",
                    "default": "#bd5ece",
                    "css_variable": "--sp-bg-menu-highlight-marker",
                    "tabs": []
                },
                {
                    "name": "Highlighted",
                    "type": "color-picker",
                    "on": "Custom",
                    "default": "#bd5ece",
                    "css_variable": "--sp-bg-menu-highlight-color-a",
                    "tabs": []
                },
                {
                    "name": "Idle",
                    "type": "color-picker",
                    "on": "Custom",
                    "default": "#2ab1ac",
                    "css_variable": "--sp-bg-menu-highlight-color-b",
                    "tabs": []
                }
            ]

        },
        "Page Highlight": {
            "type": "dropdown",
            "default": "Custom Gradient",
            "values": {
                "Default": {},
                "Darker": {
                    "page-highlights.css": [],
                    "--sp-bg-page-highlight": [ "#00000066" ]
                },
                "Brighter": {
                    "page-highlights.css": [],
                    "--sp-bg-page-highlight": [ "#ffffff66" ]
                },
                "Custom": {
                    "page-highlights.css": []
                },
                "Custom Gradient": {
                    "page-highlights.css": [],
                    "--sp-bg-page-highlight": [ "linear-gradient(138deg, var(--sp-bg-page-highlight-color-a), var(--sp-bg-page-highlight-color-b))" ]
                }
            },
            "components": [
                {
                    "name": "Color",
                    "type": "color-picker",
                    "on": "Custom",
                    "default": "#bd5ece",
                    "css_variable": "--sp-bg-page-highlight",
                    "tabs": []
                },
                {
                    "name": "Color A",
                    "type": "color-picker",
                    "on": "Custom Gradient",
                    "default": "#bd5ece",
                    "css_variable": "--sp-bg-page-highlight-color-a",
                    "tabs": []
                },
                {
                    "name": "Color B",
                    "type": "color-picker",
                    "on": "Custom Gradient",
                    "default": "#2ab1ac",
                    "css_variable": "--sp-bg-page-highlight-color-b",
                    "tabs": []
                }
            ]
        }
    },
    "id": "b1386e9d-771a-49fc-9c98-e9e8befbc3ae"
}
