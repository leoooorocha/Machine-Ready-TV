{
    "name": "Machine Ready",
    "author": "Leozito",
    "version": "v1.0",
    "description": "Clean consolifyed home screen with fullscreen hero and centered carousel.",
    "target": "Home",
    "manifest_version": 9,
    "tabs": {
        "default": [ "bigpicture" ]
    },
    "inject": {
        "shared.css": [],
        "dynamic-carousel.css": []
    },
    "patches":{
        "Hero Alignment": {
            "type": "slider",
            "default": "Cover",
            "values": {
                "Cover": {},
                "Contain": {
                    "--mr-hero-fit": [ "contain" ]
                },
                "Stretch": {
                    "--mr-hero-fit": [ "stretch" ]
                },
                "Left": {
                    "--mr-hero-position": [ "left" ]
                },
                "Right": {
                    "--mr-hero-position": [ "right" ]
                }
            }
        },
        "Carousel Position": {
            "type": "slider",
            "default": "Bottom",
            "values": {
                "Top": {
                    "carousel/top.css": []
                },
                "Center": {
                    "carousel/center.css": []
                },
                "Bottom": {
                    "carousel/bottom.css": []
                }
            }
        },
        "Carousel Navigation": {
            "type": "slider",
            "default": "Center",
            "values": {
                "Center": {},
                "Left": {
                    "--mr-scroll-padding-highlight": [ "calc(var(--mr-capsule-container-width) * 1.5)" ],
                    "--mr-scroll-padding-end": [ "calc(100vw * var(--mr-carousel-scaling-strength))" ]
                }
            }
        },
        "Carousel Scaling": {
            "type": "slider",
            "default": "1.0",
            "values": {
                "1.0": {
                    "--mr-carousel-scaling": [ "1.0" ],
                    "--mr-carousel-scaling-strength": [ "1.0" ]
                },
                "0.9": {
                    "--mr-carousel-scaling": [ "0.9" ],
                    "--mr-carousel-scaling-strength": [ "1.1" ]
                },
                "0.8": {
                    "--mr-carousel-scaling": [ "0.8" ],
                    "--mr-carousel-scaling-strength": [ "1.2" ]
                },
                "0.7": {
                    "--mr-carousel-scaling": [ "0.7" ],
                    "--mr-carousel-scaling-strength": [ "1.3" ]
                },
                "0.6": {
                    "--mr-carousel-scaling": [ "0.6" ],
                    "--mr-carousel-scaling-strength": [ "1.4" ]
                },
                "0.5": {
                    "--mr-carousel-scaling": [ "0.5" ],
                    "--mr-carousel-scaling-strength": [ "1.5" ]
                }
            }
        },
        "Dynamic Z Style": {
            "type": "slider",
            "default": "Upwards",
            "values": {
                "Upwards": {
                    "dynamic-carousel/upwards.css": []
                },
                "Magnify": {
                    "dynamic-carousel/magnify.css": []
                },
                "Downwards": {
                    "dynamic-carousel/downwards.css": []
                }
            }
        },
        "Dynamic Z Strength": {
            "type": "slider",
            "default": "5",
            "values": {
                "Off": {},
                "1": {
                    "--mr-dynamic-carousel-strength": [ "5px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "1" ]
                },
                "2": {
                    "--mr-dynamic-carousel-strength": [ "10px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "2" ]
                },
                "3": {
                    "--mr-dynamic-carousel-strength": [ "15px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "3" ]
                },
                "4": {
                    "--mr-dynamic-carousel-strength": [ "20px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "4" ]
                },
                "5": {
                    "--mr-dynamic-carousel-strength": [ "25px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "5" ]
                },
                "6": {
                    "--mr-dynamic-carousel-strength": [ "30px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "6" ]
                },
                "7": {
                    "--mr-dynamic-carousel-strength": [ "35px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "7" ]
                },
                "8": {
                    "--mr-dynamic-carousel-strength": [ "40px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "8" ]
                },
                "9": {
                    "--mr-dynamic-carousel-strength": [ "45px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "9" ]
                },
                "10": {
                    "--mr-dynamic-carousel-strength": [ "50px" ],
                    "--mr-dynamic-carousel-strength-rule": [ "10" ]
                }
            }
        },
        "Game Title Neutral Position": {
            "type": "checkbox",
            "default": "No",
            "values": {
                "No": {},
                "Yes": {
                    "--mr-game-title-final-position": [ "var(--mr-game-title-neutral-position)" ]
                }
            }
        },
        "System Font": {
            "type": "dropdown",
            "default": "Quicksand",
            "values": {
                "Default": {},
                "Quicksand": {
                    "font-face/quicksand.css": [ "bigpicture", "QuickAccess", "MainMenu" ]
                },
                "Nintendo Switch UI": {
                    "font-face/nintendo-switch-ui.css": [ "bigpicture", "QuickAccess", "MainMenu" ]
                },
                "SST (Playstation 5)": {
                    "font-face/sst.css": [ "bigpicture", "QuickAccess", "MainMenu" ]
                }
            }
        }
    },
    "id": "d575cec7-eeb4-4c9c-b5ba-48679467111b"
}
