{
    "name": "Machine Ready",
    "author": "Leozito",
    "version": "v2.0",
    "description": "Clean consolifyed home screen.",
    "target": "Home",
    "manifest_version": 9,
    "tabs": { "default": [ "bigpicture" ] },
    "inject": {
        "shared.css": [],
        "custom-fonts/shared.css": [ "bigpicture", "QuickAccess", "MainMenu" ],
        "dynamic-carousel/shared.css": [],
        "dynamic-carousel/dynamic-x.css": [],
        "dynamic-carousel/dynamic-y.css": [],
        "dynamic-carousel/dynamic-z.css": [],
        "dynamic-carousel/size-tracker.css": []
    },
    "patches": {
        "Hero Style": {
            "type": "slider",
            "default": "3",
            "values": {
                "CT": { "--mr-hero-style": [ "contain" ] },
                "1": { "--mr-hero-alignment": [ "100%" ] },
                "2": { "--mr-hero-alignment": [ "75%" ] },
                "3": { "--mr-hero-alignment": [ "50%" ] },
                "4": { "--mr-hero-alignment": [ "25%" ] },
                "5": { "--mr-hero-alignment": [ "0%" ] },
                "ST": { "--mr-hero-style": [ "stretch" ] }
            }
        },
        "Dynamic-X Left": {
            "type": "checkbox",
            "default": "No",
            "values": {
                "No": { "dynamic-carousel/x/center.css": [] },
                "Yes": { "dynamic-carousel/x/left.css": [] }
            }
        },
        "Dynamic-X Scaling": {
            "type": "slider",
            "default": "85%",
            "values": {
                "Off": { "--mr-dc-carousel-scaling": [ "1.00" ] },
                "95%": { "--mr-dc-carousel-scaling": [ "0.95" ] },
                "90%": { "--mr-dc-carousel-scaling": [ "0.90" ] },
                "85%": { "--mr-dc-carousel-scaling": [ "0.85" ] },
                "80%": { "--mr-dc-carousel-scaling": [ "0.80" ] },
                "75%": { "--mr-dc-carousel-scaling": [ "0.75" ] },
                "70%": { "--mr-dc-carousel-scaling": [ "0.70" ] }
            }
        },
        "Dynamic-Y Position": {
            "type": "slider",
            "default": "Center",
            "values": {
                "Top": { "dynamic-carousel/y/top.css": [] },
                "Center": { "dynamic-carousel/y/center.css": [] },
                "Bottom": { "dynamic-carousel/y/bottom.css": [] }
            }
        },
        "Dynamic-Z Style": {
            "type": "slider",
            "default": "Magnify",
            "values": {
                "Raise": { "dynamic-carousel/z/raise.css": [] },
                "Magnify": { "dynamic-carousel/z/magnify.css": [] },
                "Lower": { "dynamic-carousel/z/lower.css": [] }
            }
        },
        "Dynamic-Z Strength": {
            "type": "slider",
            "default": "5",
            "values": {
                "Off": { "--mr-dc-ruler": [ "0" ] },
                "1": { "--mr-dc-ruler": [ "1" ] },
                "2": { "--mr-dc-ruler": [ "2" ] },
                "3": { "--mr-dc-ruler": [ "3" ] },
                "4": { "--mr-dc-ruler": [ "4" ] },
                "5": { "--mr-dc-ruler": [ "5" ] },
                "6": { "--mr-dc-ruler": [ "6" ] },
                "7": { "--mr-dc-ruler": [ "7" ] },
                "8": { "--mr-dc-ruler": [ "8" ] },
                "9": { "--mr-dc-ruler": [ "9" ] },
                "Max": { "--mr-dc-ruler": [ "10" ] }
            }
        },
        "Custom Font": {
            "type": "dropdown",
            "default": "Quicksand",
            "values": {
                "Bitcount": { "--mr-cf-font-name": [ "Bitcount", "bigpicture", "QuickAccess", "MainMenu" ] },
                "Inter": { "--mr-cf-font-name": [ "Inter", "bigpicture", "QuickAccess", "MainMenu" ] },
                "Montenegrin": { "--mr-cf-font-name": [ "Montenegrin", "bigpicture", "QuickAccess", "MainMenu" ] },
                "Nunito": {"--mr-cf-font-name": [ "Nunito", "bigpicture", "QuickAccess", "MainMenu" ] },
                "Quicksand": { "--mr-cf-font-name": [ "Quicksand", "bigpicture", "QuickAccess", "MainMenu" ] },
                "Ubuntu": { "--mr-cf-font-name": [ "Ubuntu", "bigpicture", "QuickAccess", "MainMenu" ] },
                "UnicaOne": { "--mr-cf-font-name": [ "UnicaOne", "bigpicture", "QuickAccess", "MainMenu" ] }
            }
        }
    },
    "id": "d575cec7-eeb4-4c9c-b5ba-48679467111b"
}
