{
  "name": "Shadow Filters",
  "author": "Leozito",
  "version": "v1.1",
  "manifest_version": 9,
  "tabs": {
    "default": [ "bigpicture", "QuickAccess" ]
  },
  "inject": {
    "shared.css": [],
    "general/header.css": [],
    "general/footer.css": [],
    "home/capsules.css": [],
    "home/game-title.css": [],
    "home/game-subtitle.css": [],
    "gameview/logo.css": [],
    "gameview/playbar.css": [],
    "menus/qam-icons.css": []
  },
  "patches": {
    "▶ Global Settings:": {
      "type": "none",
      "values": {
        "_": {}
      }
    },
    "Header": {
      "type": "dropdown",
      "default": "Drop-shadows",
      "values": {
        "None": {},
        "Drop-shadows": {
          "--shadow-filters-header": [ "var(--shadow-filters-drop-shadows)" ]
        },
        "Stroke": {
          "--shadow-filters-header": [ "var(--shadow-filters-3d-stroke)" ]
        }
      }
    },
    "Footer": {
      "type": "dropdown",
      "default": "Drop-shadows",
      "values": {
        "None": {},
        "Drop-shadows": {
          "--shadow-filters-footer": [ "var(--shadow-filters-drop-shadows)" ]
        },
        "Stroke": {
          "--shadow-filters-footer": [ "var(--shadow-filters-3d-stroke)" ]
        }
      }
    },
    "▶ Home Settings:": {
      "type": "none",
      "values": {
        "_": {}
      }
    },
    "Game Title": {
      "type": "dropdown",
      "default": "Drop-shadows",
      "values": {
        "None": {},
        "Drop-shadows": {
          "--shadow-filters-game-title": [ "var(--shadow-filters-drop-shadows)" ]
        },
        "Stroke": {
          "--shadow-filters-game-title": [ "var(--shadow-filters-3d-stroke)" ]
        }
      }
    },
    "Game Subtitle": {
      "type": "dropdown",
      "default": "Drop-shadows",
      "values": {
        "None": {},
        "Drop-shadows": {
          "--shadow-filters-game-subtitle": [ "var(--shadow-filters-drop-shadows)" ]
        },
        "Stroke": {
          "--shadow-filters-game-subtitle": [ "var(--shadow-filters-3d-stroke)" ]
        }
      }
    },
    "Capsules Drop-shadows": {
      "type": "dropdown",
      "default": "Idle and Focus",
      "values": {
        "None": {},
        "Only Idle": {
          "--shadow-filters-capsule-idle": [ "var(--shadow-filters-capsule-soft)" ]
        },
        "Only Focus": {
          "--shadow-filters-capsule-focus": [ "var(--shadow-filters-capsule-hard)" ]
        },
        "Idle and Focus": {
          "--shadow-filters-capsule-idle": [ "var(--shadow-filters-capsule-soft)" ],
          "--shadow-filters-capsule-focus": [ "var(--shadow-filters-capsule-hard)" ]
        }
      }
    },
    "▶ Gameview Settings:": {
      "type": "none",
      "values": {
        "_": {}
      }
    },
    "Logo": {
      "type": "dropdown",
      "default": "Drop-shadows",
      "values": {
        "None": {},
        "Drop-shadows": {
          "--shadow-filters-logo": [ "var(--shadow-filters-drop-shadows)" ]
        },
        "Stroke": {
          "--shadow-filters-logo": [ "var(--shadow-filters-3d-stroke)" ]
        }
      }
    },
    "(This will also affect the logo when launching a game)": {
      "type": "none",
      "values": {
        "_": {}
      }
    },
    "Playbar Text": {
      "type": "dropdown",
      "default": "None",
      "values": {
        "None": {},
        "Drop-shadows": {
          "--shadow-filters-playbar": [ "var(--shadow-filters-drop-shadows)" ]
        },
        "Stroke": {
          "--shadow-filters-playbar": [ "var(--shadow-filters-3d-stroke)" ]
        }
      }
    },
    "▶ Menus Settings:": {
      "type": "none",
      "values": {
        "_": {}
      }
    },
    "QAM Icons": {
      "type": "dropdown",
      "default": "Drop-shadows",
      "values": {
        "None": {},
        "Drop-shadows": {
          "--shadow-filters-qam": [ "var(--shadow-filters-drop-shadows)" ]
        },
        "Stroke": {
          "--shadow-filters-qam": [ "var(--shadow-filters-3d-stroke)" ]
        }
      }
    }
  },
  "id": "159fed6f-ae41-4ee3-b157-390c357fe800"
}
