{
    "name": "Clean Gameview",
    "author": "SuchMeme, Leozito",
    "version": "v2.0",
    "description": "Fullscreen clean gameview.",
    "manifest_version": 9,
    "tabs": {
        "default": [ "bigpicture" ]
    },
    "inject": {
        "shared.css": []
    },
    "patches": {
        "Art Cover Alignment": {
            "type": "dropdown",
            "default": "Cover",
            "values": {
                "Cover": {},
                "Contain": {
                    "--CGV-hero-alignment": [ "contain" ]
                },
                "Stretch": {
                    "--CGV-hero-alignment": [ "stretch" ]
                },
                "Left": {
                    "--CGV-hero-position": [ "left" ]
                },
                "Right": {
                    "--CGV-hero-position": [ "right" ]
                }
            }
        },
        "Lock Logo": {
            "type": "checkbox",
            "default": "Yes",
            "values": {
                "No": {},
                "Yes": {
                    "locked-logo.css": []
                }
            }
        },
        "Playbar Style": {
            "type": "dropdown",
            "default": "Semi-transparent",
            "values": {
                "Connected": {},
                "Semi-transparent": {
                    "--CGV-hero-height": [ "100vh" ],
                    "--CGV-playbar-background": [ "rgba(0, 0, 0, .7)" ]
                },
                "Fully Transparent": {
                    "--CGV-hero-height": [ "100vh" ],
                    "--CGV-playbar-background": [ "transparent" ],
                    "--cgv-buttons-bg": [ "black" ],
                    "--cgv-icon-bg": [ "black !important" ]
                },
                "Blurred": {
                    "--CGV-hero-height": [ "100vh" ],
                    "--CGV-playbar-background-filter": [ "blur(8px)" ]
                }
            }
        },
        "Steam Cloud": {
            "type": "dropdown",
            "default": "Button",
            "values": {
                "Default": {},
                "Icon": {
                    "steam-cloud.css": [],
                    "--cgv-icon-bg": [ "transparent !important" ]
                },
                "Button": {
                    "steam-cloud.css": [],
                    "--cgv-icon-size": [ "12px" ],
                    "--cgv-icon-top-padding": [ "16px" ]
                }
            }
        },
        "Footer Height": {
            "type": "dropdown",
            "default": "40px",
            "values": {
                "40px": {},
                "30px": {
                    "--CGV-footer-height": [ "30px" ]
                },
                "20px": {
                    "--CGV-footer-height": [ "20px" ]
                },
                "No Footer": {
                    "--CGV-footer-height": [ "0px" ]
                }
            }
        }
    },
    "id": "a9776f60-2724-4ff0-824b-e1f82a04688e"
}
