{
    "name": "Button Styled QAM",
    "author": "Leozito",
    "version": "v2.0",
    "manifest_version": 9,
    "tabs": {
        "default": [ "bigpicture", "QuickAccess" ]
    },
    "inject": {
        "shared.css": []
    },
    "patches": {
        "▶ Colors:": {
            "type": "none",
            "values": {
                "_": {}
            },
            "components": [
                {
                    "name": "Icon",
                    "type": "color-picker",
                    "on": "_",
                    "default": "#FFFFFFFF",
                    "css_variable": "--bsqam-icon-color",
                    "tabs": []
                },
                {
                    "name": "Background",
                    "type": "color-picker",
                    "on": "_",
                    "default": "#00000000",
                    "css_variable": "--bsqam-icon-background",
                    "tabs": []
                },
                {
                    "name": "Icon (Selected)",
                    "type": "color-picker",
                    "on": "_",
                    "default": "#FFFFFFFF",
                    "css_variable": "--bsqam-icon-color-selected",
                    "tabs": []
                },
                {
                    "name": "Background (Selected)",
                    "type": "color-picker",
                    "on": "_",
                    "default": "#1980e6",
                    "css_variable": "--bsqam-icon-background-selected",
                    "tabs": []
                },
                {
                    "name": "Border Color",
                    "type": "color-picker",
                    "on": "_",
                    "default": "#FFFFFFFF",
                    "css_variable": "--bsqam-border-color",
                    "tabs": []
                }
            ]
        },
        "▶ Border Type:": {
            "type": "slider",
            "default": "2",
            "values": {
                "0": {
                    "--bsqam-border-type": [ "hidden" ]
                },
                "1": {
                    "--bsqam-border-type": [ "solid" ]
                },
                "2": {
                    "--bsqam-border-type": [ "dashed" ]
                },
                "3": {
                    "--bsqam-border-type": [ "double" ]
                },
                "4": {
                    "--bsqam-border-type": [ "outset" ]
                }
            }
        },
        "Radius": {
            "type": "slider",
            "default": "15px",
            "values": {
                "0px": {
                    "--bsqam-border-radius": [ "0px" ]
                },
                "2px": {
                    "--bsqam-border-radius": [ "2px" ]
                },
                "5px": {
                    "--bsqam-border-radius": [ "5px" ]
                },
                "10px": {
                    "--bsqam-border-radius": [ "10px" ]
                },
                "15px": {
                    "--bsqam-border-radius": [ "15px" ]
                },
                "20px": {
                    "--bsqam-border-radius": [ "20px" ]
                },
                "25px": {
                    "--bsqam-border-radius": [ "25px" ]
                }
            }
        }
    },
    "id": "00739d61-6325-4ae0-8233-5e89559877bf"
}
