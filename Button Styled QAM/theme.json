{
    "name": "Button Styled QAM",
    "author": "Leozito",
    "version": "v2.0",
    "manifest_version": 9,
    "tabs": {
        "default": [ "bigpicture", "QuickAccess" ]
    },
    "inject": {
        "shared.css": []
    },
    "patches": {
        "Custom Colors - Idle": {
            "type": "checkbox",
            "default": "No",
            "values": {
                "No": {},
                "Yes": {}
            },
            "components": [
                {
                    "name": "Idle FG",
                    "type": "color-picker",
                    "on": "Yes",
                    "default": "#FFF",
                    "css_variable": "--bsqam-icon-color",
                    "tabs": []
                },
                {
                    "name": "Idle BG",
                    "type": "color-picker",
                    "on": "Yes",
                    "default": "#000",
                    "css_variable": "--bsqam-icon-background",
                    "tabs": []
                }
            ]
        },
        "Custom Colors - Selected": {
            "type": "checkbox",
            "default": "No",
            "values": {
                "No": {},
                "Yes": {}
            },
            "components": [
                {
                    "name": "Selected FG",
                    "type": "color-picker",
                    "on": "Yes",
                    "default": "#000",
                    "css_variable": "--bsqam-icon-color-selected",
                    "tabs": []
                },
                {
                    "name": "Selected BG",
                    "type": "color-picker",
                    "on": "Yes",
                    "default": "#FFF",
                    "css_variable": "--bsqam-icon-background-selected",
                    "tabs": []
                }
            ]
        },
        "Border Radius": {
            "type": "slider",
            "default": "15px",
            "values": {
                "2px": {},
                "5px": {
                    "--bsqam-border-radius": [ "5px" ]
                },
                "10px": {
                    "--bsqam-border-radius": [ "10px" ]
                },
                "15px": {
                    "--bsqam-border-radius": [ "15px" ]
                },
                "20px": {
                    "--bsqam-border-radius": [ "20px" ]
                },
                "25px": {
                    "--bsqam-border-radius": [ "25px" ]
                }

            }
        }
    },
    "id": "00739d61-6325-4ae0-8233-5e89559877bf"
}
