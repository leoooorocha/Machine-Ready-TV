{
    "name": "Dynamic Carousel",
    "author": "Leozito",
    "version": "v1.0",
    "manifest_version": 9,
    "tabs": {
        "default": [ "bigpicture" ]
    },
    "inject": {
        "shared.css": []
    },
    "patches": {
        "Balance": {
            "type": "slider",
            "default": "5",
            "values": {
                "1": {
                    "--dc-carousel-idle-var": [ "-10px" ],
                    "--dc-carousel-focus-var": [ "10px" ]
                },
                "2": {
                    "--dc-carousel-idle-var": [ "-15px" ],
                    "--dc-carousel-focus-var": [ "15px" ]
                },
                "3": {
                    "--dc-carousel-idle-var": [ "-20px" ],
                    "--dc-carousel-focus-var": [ "20px" ]
                },
                "4": {
                    "--dc-carousel-idle-var": [ "-25px" ],
                    "--dc-carousel-focus-var": [ "25px" ]
                },
                "5": {
                    "--dc-carousel-idle-var": [ "-30px" ],
                    "--dc-carousel-focus-var": [ "30px" ]
                },
                "6": {
                    "--dc-carousel-idle-var": [ "-35px" ],
                    "--dc-carousel-focus-var": [ "35px" ]
                },
                "7": {
                    "--dc-carousel-idle-var": [ "-40px" ],
                    "--dc-carousel-focus-var": [ "40px" ]
                },
                "8": {
                    "--dc-carousel-idle-var": [ "-45px" ],
                    "--dc-carousel-focus-var": [ "45px" ]
                },
                "9": {
                    "--dc-carousel-idle-var": [ "-50px" ],
                    "--dc-carousel-focus-var": [ "50px" ]
                }
            }
        },
        "Safe Magnify": {
            "type": "checkbox",
            "default": "Yes",
            "values": {
                "No": {
                    "aggresive-magnify.css": []
                },
                "Yes": {
                    "safe-magnify.css": []
                }
            }
        }
    },
    "id": "007a476e-41fc-4d6e-aa2e-72fa5498e49e"
}
