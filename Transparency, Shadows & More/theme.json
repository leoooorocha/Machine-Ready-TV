        "★ Glass Opacity": {
            "type": "slider",
            "default": "0.8",
            "values": {
                "0.1": { "--tsam-glass-opacity": [ "0.1" ] },
                "0.2": { "--tsam-glass-opacity": [ "0.2" ] },
                "0.3": { "--tsam-glass-opacity": [ "0.3" ] },
                "0.4": { "--tsam-glass-opacity": [ "0.4" ] },
                "0.5": { "--tsam-glass-opacity": [ "0.5" ] },
                "0.6": { "--tsam-glass-opacity": [ "0.6" ] },
                "0.7": { "--tsam-glass-opacity": [ "0.7" ] },
                "0.8": { "--tsam-glass-opacity": [ "0.8" ] },
                "0.9": { "--tsam-glass-opacity": [ "0.9" ] }
            }
