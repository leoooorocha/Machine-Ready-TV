        "Controller Menu Background": {
            "type": "dropdown",
            "default": "OLED Black",
            "values": {
                "Default": {},
                "★ Glass": {
                    "menus/controller-menu-background.css": [],
                    "--tsam-controller-menu-background": [ "var(--tsam-glass)" ]

                },
                "OLED Black": {
                    "menus/controller-menu-background.css": [],
                    "--tsam-controller-menu-background": [ "black" ]
                },
                "Custom": {
                    "menus/controller-menu-background.css": []
