            "type": "dropdown",
            "default": "Transparent",
            "values": {
                "Default": {},
                "Transparent": {
                    "menus/sidebar-background.css": []
                },
                "★ Glass": {
                    "menus/sidebar-background.css": [],
                    "--tsam-sidebar-background": [ "var(--tsam-glass)" ]
                },
                "OLED Black": {
                    "menus/sidebar-background.css": [],
                    "--tsam-sidebar-background": [ "black" ]
                },
                "Custom": {
                    "menus/sidebar-background.css": []
                },
                "Custom Gradient": {
                    "menus/sidebar-background.css": [],
                    "--tsam-sidebar-background": [ "linear-gradient(90deg, var(--tsam-sidebar-background-color-a), var(--tsam-sidebar-background-color-b))" ]
                }
            },
            "components": [
                {
                    "name": "Main Color",
                    "type": "color-picker",
                    "on": "Custom",
                    "default": "#400040",
