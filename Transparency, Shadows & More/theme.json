        "Sidebar Style": {
            "type": "dropdown",
            "default": "Dropshadows",
            "values": {
                "Default": {},
                "Dropshadows": {
                    "menus/sidebar-style.css": [],
                    "--tsam-qam-sidebar-filter": [ "var(--tsam-dropshadows)" ]
                },
                "Stroke": {
                    "menus/sidebar-style.css": [],
                    "--tsam-qam-sidebar-filter": [ "var(--tsam-stroke)" ]
                }
            }
        },
        "QAM Background": {
            "type": "dropdown",
            "default": "★ Glass",
            "values": {
                "Default": {},
                "Transparent": {
                    "menus/qam-background.css": []
                },
                "★ Glass": {
                    "menus/qam-background.css": [],
                    "--tsam-qam-background": [ "var(--tsam-glass)" ],
                    "--tsam-qam-title-background": [ "transparent" ],
                    "--tsam-qam-title-box-shadow-color": [ "transparent" ]
                },
                "OLED Black": {
                    "menus/qam-background.css": [],
                    "--tsam-qam-background": [ "black" ]
                },
                "Custom": {
                    "menus/qam-background.css": []
                },
                "Custom Gradient": {
                    "menus/qam-background.css": [],
                    "--tsam-qam-background": [ "linear-gradient(90deg, var(--tsam-qam-background-color-a), var(--tsam-qam-background-color-b))" ],
                    "--tsam-qam-title-background": [ "transparent" ],
                    "--tsam-qam-title-box-shadow-color": [ "transparent" ]
                }
            },
            "components": [
                {
                    "name": "Main Color",
                    "type": "color-picker",
                    "on": "Custom",
                    "default": "#400040",
                    "css_variable": "--tsam-qam-background",
                    "tabs": []
                },
                {
                    "name": "Main Color A",
                    "type": "color-picker",
                    "on": "Custom Gradient",
                    "default": "#bd5ece",
                    "css_variable": "--tsam-qam-background-color-a",
                    "tabs": []
                },
                {
                    "name": "Main Color B",
                    "type": "color-picker",
                    "on": "Custom Gradient",
                    "default": "#2ab1ac",
                    "css_variable": "--tsam-qam-background-color-b",
                    "tabs": []
                }
            ]
        },
        "In-game Menu Background": {
            "type": "dropdown",
            "default": "Custom Gradient",
            "values": {
                "Default": {},
                "★ Glass": {
                    "menus/ingame-menu-background.css": [],
                    "--tsam-ingame-menu-background": [ "var(--tsam-glass)" ]

                },
                "OLED Black": {
                    "menus/ingame-menu-background.css": [],
                    "--tsam-ingame-menu-background": [ "black" ]
                },
                "Custom": {
                    "menus/ingame-menu-background.css": []
