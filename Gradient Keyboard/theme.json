{
    "name": "Gradient Keyboard",
    "author": "Leozito",
    "version": "v1.0",
    "description": "Custom keyboard background, featuring light and dark themes.",
    "target": "Keyboard",
    "manifest_version": 9,
    "tabs": {
        "default": [ "bigpicture", "MainMenu", "QuickAccess" ]
    },
    "inject": {
        "shared.css": []
    },
    "patches": {
        "Keyboard Background": {
            "type": "dropdown",
            "default": "Custom Gradient",
            "values": {
                "Light": {
                    "--gk-keyboard-bg": [ "#E6E6E6" ]
                },
                "Grey": {
                    "--gk-keyboard-bg": [ "#808080" ]
                },
                "Dark": {
                    "--gk-keyboard-bg": [ "#1A1A1A" ]
                },
                "Custom": {},
                "Custom Gradient": {
                    "--gk-keyboard-bg": [ "linear-gradient(var(--gk-gradient-direction), var(--gk-keyboard-bg-color-a), var(--gk-keyboard-bg-color-b))" ]
                }
            },
            "components": [
                {
                    "name": "Main Color",
                    "type": "color-picker",
                    "on": "Custom",
                    "default": "#FF8000",
                    "css_variable": "--gk-keyboard-bg",
                    "tabs": []
                },
                {
                    "name": "Gradient Color 1",
                    "type": "color-picker",
                    "on": "Custom Gradient",
                    "default": "#bd5ece",
                    "css_variable": "--gk-keyboard-bg-color-a",
                    "tabs": []
                },
                {
                    "name": "Gradient Color 2",
                    "type": "color-picker",
                    "on": "Custom Gradient",
                    "default": "#2ab1ac",
                    "css_variable": "--gk-keyboard-bg-color-b",
                    "tabs": []
                }
            ]
        },
        "Gradient Direction": {
            "type": "slider",
            "default": "135° ↘",
            "values":{
                "45° ↗": { "--gk-gradient-direction": [ "45deg" ] },
                "90° →": { "--gk-gradient-direction": [ "90deg" ] },
                "135° ↘": { "--gk-gradient-direction": [ "135deg" ] },
                "180° ↓": { "--gk-gradient-direction": [ "180deg" ] }
            }
        },
        "Main Theme": {
            "type": "dropdown",
            "default": "Light",
            "values": {
                "Light": {
                    "themes/light.css": []
                },
                "Dark": {
                    "themes/dark.css": []
                }
            }
        },
        "Main Color": {
            "type": "dropdown",
            "default": "Theme Default",
            "values": {
                "Theme Default": {},
                "Red": {
                    "--gk-highlight-fg": [ "hsla(0, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(12%) sepia(96%) saturate(7464%) hue-rotate(3deg) brightness(110%) contrast(112%) !important" ]
                },
                "Orange": {
                    "--gk-highlight-fg": [ "hsla(30, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(71%) sepia(59%) saturate(5464%) hue-rotate(358deg) brightness(98%) contrast(109%) !important" ]
                },
                "Yellow": {
                    "--gk-highlight-fg": [ "hsla(60, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(91%) sepia(27%) saturate(1860%) hue-rotate(4deg) brightness(107%) contrast(111%) !important" ]
                },
                "Lime": {
                    "--gk-highlight-fg": [ "hsla(90, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(80%) sepia(66%) saturate(1243%) hue-rotate(34deg) brightness(97%) contrast(119%) !important" ]
                },
                "Green": {
                    "--gk-highlight-fg": [ "hsla(120, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(60%) sepia(73%) saturate(2773%) hue-rotate(79deg) brightness(113%) contrast(127%) !important" ]
                },
                "Mint": {
                    "--gk-highlight-fg": [ "hsla(150, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(82%) sepia(42%) saturate(4848%) hue-rotate(94deg) brightness(110%) contrast(101%) !important" ]
                },
                "Cyan": {
                    "--gk-highlight-fg": [ "hsla(180, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(84%) sepia(76%) saturate(703%) hue-rotate(102deg) brightness(102%) contrast(105%) !important" ]
                },
                "Blue": {
                    "--gk-highlight-fg": [ "hsla(210, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(32%) sepia(57%) saturate(3413%) hue-rotate(198deg) brightness(103%) contrast(106%) !important" ]
                },
                "Indigo": {
                    "--gk-highlight-fg": [ "hsla(240, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(8%) sepia(100%) saturate(7253%) hue-rotate(248deg) brightness(100%) contrast(143%) !important" ]
                },
                "Purple": {
                    "--gk-highlight-fg": [ "hsla(270, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(11%) sepia(93%) saturate(6161%) hue-rotate(271deg) brightness(103%) contrast(127%) !important" ]
                },
                "Magenta": {
                    "--gk-highlight-fg": [ "hsla(300, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(16%) sepia(97%) saturate(3885%) hue-rotate(295deg) brightness(119%) contrast(123%); !important" ]
                },
                "Pink": {
                    "--gk-highlight-fg": [ "hsla(330, 100%, 50%, 1) !important" ],
                    "--gk-glyph-filter": [ "invert(18%) sepia(94%) saturate(7227%) hue-rotate(323deg) brightness(102%) contrast(107%); !important" ]
                }

            }
        }
    },
    "id": "e08b906c-43ef-40ef-82b2-dae40d02f523"
}
