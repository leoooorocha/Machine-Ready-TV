{
  "name": "Button Styled Cloud",
  "author": "Leozito",
  "version": "v1.2",
  "manifest_version": 9,
  "tabs": {
    "default": [
      "bigpicture"
    ]
  },
  "inject": {
    "shared.css": []
  },
  "patches": {
    "Foreground Color": {
      "type": "dropdown",
      "default": "White",
      "values": {
        "White": {},
        "Black": {
          "--bsc-foreground-color": [
            "black"
          ]
        },
        "Custom": {}
      },
      "components": [
        {
          "name": "Icon Color",
          "type": "color-picker",
          "on": "Custom",
          "default": "#FFF",
          "css_variable": "--bsc-foreground-color",
          "tabs": []
        }
      ]
    },
    "Background Color": {
      "type": "dropdown",
      "default": "Default",
      "values": {
        "Default": {},
        "White": {
          "--bsc-background-color": [
            "white"
          ]
        },
        "Black": {
          "--bsc-background-color": [
            "black"
          ]
        },
        "Custom": {}
      },
      "components": [
        {
          "name": "Background Color",
          "type": "color-picker",
          "on": "Custom",
          "default": "#000",
          "css_variable": "--bsc-background-color",
          "tabs": []
        }
      ]
    }
  },
  "id": "c116f00e-7945-4adc-b70f-7cb9febc3af4"
}
